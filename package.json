{
  "name": "quantumaml-nexus",
  "version": "1.0.0",
  "private": true,
  "description": "QuantumAML Nexus - Real-Time Anti-Money Laundering Detection Engine",
  "scripts": {
    "backend": "powershell -ExecutionPolicy Bypass -Command \".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload\"",
    "streamer": "powershell -ExecutionPolicy Bypass -Command \".\\.venv\\Scripts\\python.exe streamer.py\"",
    "crypto": "powershell -ExecutionPolicy Bypass -Command \".\\.venv\\Scripts\\python.exe live_crypto_feed.py\"",
    "dev": "npm --prefix nexus-frontend run dev",
    "dev:all": "powershell -ExecutionPolicy Bypass -File ./run_all.ps1",
    "all": "powershell -ExecutionPolicy Bypass -File ./run_all.ps1",
    "start": "powershell -ExecutionPolicy Bypass -File ./run_all.ps1",
    "build": "npm --prefix nexus-frontend run build",
    "preflight": "powershell -ExecutionPolicy Bypass -File ./run_preflight_checks.ps1"
  }
}
