# ==============================================================================
# QuantumAML Nexus - Hardened Enterprise Dashboard Containerfile
# ==============================================================================
# Step 5.4.1: Production Container Packaging for Streamlit AML Platform
# Enforces:
#   - Python 3.11 Slim base runtime
#   - Lightweight containerized Streamlit dashboard serving
#   - Port 8501 exposure
# ==============================================================================

FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Install lightweight PyTorch CPU wheels to eliminate bloated CUDA binaries
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt streamlit

COPY app/ ./app/
COPY models/ ./models/
COPY dashboard.py .
COPY app.py .
COPY five_dataset_new_evaluation_results.json .

EXPOSE 8501

ENTRYPOINT ["streamlit", "run", "dashboard.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
