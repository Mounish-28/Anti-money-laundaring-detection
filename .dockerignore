# Version control
.git/
.gitignore

# Python bytecode, caches, and environments
__pycache__/
*.py[cod]
*$py.class
*.pyd
.venv/
venv/
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE configurations
.vscode/
.idea/
*.swp
*.swo

# Exclude all raw datasets and archives
**/*.csv
!models/risk_tiers.csv
**/*.parquet
**/*.zip
**/*.tar.gz

# Exclude JSON files except configurations under app/, evaluation benchmarks, and model metadata
**/*.json
!app/**/*.json
!five_dataset_new_evaluation_results.json
!models/*.json
!models/**/*.json

# Exclude heavy binary model checkpoints from build context (mounted as read-only volume at runtime)
models/*.pt
models/**/*.pt
models/*.joblib
models/**/*.joblib
models/*.cbm
models/**/*.cbm
models/*.bin
models/**/*.bin
models/*.xgb
models/**/*.xgb

# Ephemeral runtime logs & databases
*.log
catboost_info/
alerts.db
runtime_audit_results.json
